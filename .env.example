# --- Supabase ---
# Project Settings > API > Project URL
SUPABASE_URL=

# Project Settings > API > service_role key (NOT the anon/public key).
# The schema created by db/schema.sql has no RLS policies, and this agent
# writes from a trusted server-side context with no end-user auth session,
# so the anon key will be rejected by RLS. Keep this secret.
SUPABASE_KEY=

# Optional. Project Settings > Database > Connection string (URI, "Session" mode).
# Only used by `python -m competitor_analysis_agent.db.setup_db` to run schema.sql
# automatically via a direct Postgres connection (supabase-py cannot run DDL).
# If left empty, setup_db.py prints the SQL for you to paste into the Supabase SQL Editor.
SUPABASE_DB_URL=

# --- Gemini ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

GEMINI_MODEL=gemini-3.1-flash-lite

# --- Apify ---
APIFY_API_TOKEN=
